+// nonUserDefinedNetwork returns a built-in network that is not user-defined on the current platform.
+// On Windows "bridge" and "host" are user-defined networks; the default bridge network is called "nat".
+func nonUserDefinedNetwork(linux string) string {
+	if runtime.GOOS == "windows" {
+		return "nat"
+	}
+	return linux
+}
